# macOS
.DS_Store

# Editor swap/temp files
*.swp
*.swo
*~

# Python (in case ad-hoc scripts run from repo root)
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Local-only data — see reports/.gitignore for the bot's runtime data
.env

# Claude Code local settings (preview server config)
.claude/

# Regenerable CAD meshes / slicer gcode (sources kept: .step .bgcode .png .py)
# STL — build files ARE published for hardware, ignored everywhere else.
# A blanket *.stl silently blocked adding any new enclosure build file;
# the v5 STLs only survived because git mv keeps tracked files tracked.
*.stl
!hardware/**/*.stl
*.gcode
*.3mf

# Secrets — never commit any env file (vision.env, *.env, etc.)
*.env

# Enclosure R&D outputs — regenerate from tools/*.py (see enclosure/DESIGN_LOG.md)
hardware/diy-node/enclosure/**/*.step
hardware/diy-node/enclosure/**/*.bgcode
hardware/diy-node/enclosure/**/*.png
hardware/kit1-hex/**/*.step
hardware/kit1-enclosure/**/*.step
# scratch and third-party reference dumps
hardware/diy-node/enclosure/_b64_tmp.txt
hardware/diy-node/enclosure/ref_*/
hardware/kit1-hex/ref_seeed/
Claude outputs/
*.bundle
