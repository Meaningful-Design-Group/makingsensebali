// Copy this file to secrets.h and fill in your values:
//
//     cp secrets.h.example secrets.h
//
// secrets.h is gitignored. Never commit it, and never paste a real token into
// an issue, a screenshot, or a chat log.
//
// The Smart Citizen device token is a WRITE credential - it is the only thing
// preventing anyone from publishing arbitrary readings into your device. For a
// campaign whose data is meant to be trusted, a poisonable stream is a worse
// problem than a leaked WiFi password. If it leaks, revoke and reissue it from
// the device dashboard: a cleanup commit does NOT remove it from git history.

#pragma once

// From your device page on smartcitizen.me. For a DIY node there is no numeric
// device id to configure - the token is the whole identity.
const char* SC_DEVICE_TOKEN = "YOUR_DEVICE_TOKEN";
